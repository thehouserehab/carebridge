    "dev:synthetic-wifi": "node scripts/synthetic-wifi-api.mjs",
    "test:synthetic-e": "node tests/windows-synthetic-session-check.mjs",
    "test:synthetic-e:resume": "node tests/windows-synthetic-resume-check.mjs",
