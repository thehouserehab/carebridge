    "test:local-child-activities:browser": "node tests/local-child-activities-browser.mjs --confirm-synthetic-local",
    "test:local-operations:browser": "node tests/local-operations-browser.mjs --confirm-synthetic-local",
    "test:local-enrollment:browser": "node tests/local-enrollment-browser.mjs --confirm-synthetic-local",
    "test:local-invitations:browser": "node tests/local-invitations-browser.mjs --confirm-synthetic-local",
    "test:local-recovery:browser": "node tests/local-recovery-browser.mjs --confirm-synthetic-local",
