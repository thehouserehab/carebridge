    "test:communication:browser": "node tests/communication-matrix.mjs",
    "test:chat-send:browser": "node tests/chat-send-lifecycle-browser.mjs",
    "test:messages:browser": "node tests/message-lifecycle-browser.mjs",
    "test:messages:local": "node tests/message-lifecycle-local.mjs --confirm-synthetic-local",
    "test:password-recovery:local": "node tests/password-recovery-browser.mjs --confirm-synthetic-local",
    "test:history-surfaces:local": "node tests/history-surface-browser.mjs --confirm-synthetic-local",
    "test:assessment-rows:local": "node tests/assessment-rows-browser.mjs --confirm-synthetic-local",
    "test:empty-assignment:browser": "node tests/empty-assignment-browser.mjs",
    "test:dialog-sync:browser": "node tests/dialog-sync-browser.mjs",
