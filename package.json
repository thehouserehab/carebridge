    "test:postgres:e-drive": "node server/windows-postgres-check.mjs",
    "test:database-privileges:e-drive": "node server/windows-postgres-check.mjs --verify-role-privileges",
    "test:native-worker:e-drive": "node server/windows-postgres-check.mjs --verify-native-media",
